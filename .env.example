# Browser and model infrastructure (required from Checkpoint 3 onward)
BROWSERBASE_API_KEY=
BROWSERBASE_BROWSER_MODEL=google/gemini-3.5-flash

# Free Gemini API key used for structured target resolution and planning
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Public deployment URL, for example https://gofetch.example.com
APP_BASE_URL=http://localhost:3000
