# Browser and model infrastructure (required from Checkpoint 3 onward)
BROWSERBASE_API_KEY=
BROWSERBASE_BROWSER_MODEL=google/gemini-2.5-flash

# Optional direct Gemini key for planning. When omitted, GoFetch uses Browserbase
# Model Gateway with BROWSERBASE_BROWSER_MODEL and no second provider key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Public deployment URL, for example https://gofetch.example.com
APP_BASE_URL=http://localhost:3000
